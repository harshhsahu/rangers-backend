NODE_ENV=development
PORT=4000
CORS_ORIGIN=*

# Upstream GTWY services
PYTHON_SERVER_URL=
SERVER_URL=
# Public URL of the frontend (fallback for RANGER_PUBLIC_URL / TELEGRAM_WEBHOOK_BASE_URL)
FRONTEND_URL=
# MSG91 proxy used by /api/auth/internal-login (defaults to https://routes.msg91.com)
PROXY_URL=
# Same value as the frontend's NEXT_PUBLIC_ENV; prefixes the local_token cookie name.
APP_ENV=

# Internal auth — JWT { org_id, folder_id, user_id } signed with ACCESS_KEY
ORG_ID=
FOLDER_ID=
ACCESS_KEY=
# Identifies this app to the GTWY completion API; never sent to the browser.
GTWY_PAUTH_KEY=

MONGODB_URI=
# AES-256 key material for encrypting bot tokens at rest (falls back to ACCESS_KEY)
CHANNEL_ENCRYPTION_KEY=

# Public HTTPS origin Telegram delivers webhooks to (…/api/telegram/webhook).
# Either the frontend (which proxies /api/*) or this backend directly.
TELEGRAM_WEBHOOK_BASE_URL=
# Where the ranger-update agent's tools and EasyCron call back. Optional: falls back to
# TELEGRAM_WEBHOOK_BASE_URL, then FRONTEND_URL. Set it to a tunnel during local
# development — the agent runs on GTWY's servers and cannot reach localhost.
RANGER_PUBLIC_URL=

# Scheduler (EasyCron)
EASYCRON_API_KEY=
# Optional: EasyCron dashboard group all jobs are created under.
EASYCRON_GROUP_ID=
# How many schedules one ranger may hold. Defaults to 10.
SCHEDULER_MAX_PER_RANGER=
# Guards /api/scheduler/reconcile, which spans every org. Unset means that route answers 404.
SCHEDULER_ADMIN_KEY=

# Discord / Telegram tuning (optional)
DISCORD_INTERNAL_SECRET=
DISCORD_MAX_ATTACHMENT_BYTES=
DISCORD_DRAFT_CHUNK_THRESHOLD=
TELEGRAM_DRAFT_CHUNK_THRESHOLD=
